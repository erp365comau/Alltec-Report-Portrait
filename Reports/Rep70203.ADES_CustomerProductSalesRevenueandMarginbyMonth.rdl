  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function CalcGPPerc(ByVal SalesRevenue As Decimal,ByVal GPAmount As Decimal)
    if SalesRevenue = 0 then
        Return ""
    end if
    Return (GPAmount / SalesRevenue) * 100
End Function

Public Function CalcAvgPrice(ByVal InvoicedQty As Decimal,ByVal SalesRevenue As Decimal)
    if InvoicedQty = 0 then
        Return ""
    end if
    Return (SalesRevenue / InvoicedQty)
End Function</Code>
